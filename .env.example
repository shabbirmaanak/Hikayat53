# ===================================================
# Hikayat (حكاية) Environment Configuration
# ===================================================

# Turso Database Credentials (Remote or Local libSQL)
# For remote Turso database:
# TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
# TURSO_AUTH_TOKEN="your-turso-jwt-token"

# For local development with SQLite / local libSQL file (default if remote unset):
TURSO_DATABASE_URL="file:hikayat_local.db"
TURSO_AUTH_TOKEN=""

# Cloudflare R2 Public Media Bucket URL (Zero Egress Audio CDN)
# Example: https://pub-abc123456789.r2.dev/audio
NEXT_PUBLIC_R2_MEDIA_URL="https://pub-hikayat-demo.r2.dev/audio"

# Cloudflare R2 S3-Compatible Credentials (for scripts/upload-r2.ts)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="hikayat-audio"
